{
  "name": "keyjump",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: press ; to label every link, button and field, then type to jump.",
  "license": "MIT",
  "homepage": "https://github.com/vliejo/keyjump",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vliejo/keyjump.git"
  },
  "bugs": {
    "url": "https://github.com/vliejo/keyjump/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "check": "node scripts/check.mjs",
    "build": "pnpm icons && pnpm check",
    "package": "pnpm build && node scripts/package.mjs",
    "store:token": "node scripts/cws-token.mjs",
    "store:status": "node scripts/publish.mjs --status",
    "store:upload": "node scripts/publish.mjs",
    "store:submit": "node scripts/publish.mjs --publish",
    "demo": "node scripts/serve.mjs"
  }
}
