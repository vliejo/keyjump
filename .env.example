# Chrome Web Store API credentials. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real values — see docs/PUBLISHING.md for
# where each of these comes from.

# The 32-character item id from the dashboard URL (letters a-p).
CWS_EXTENSION_ID=

# From the OAuth "Desktop app" client in Google Cloud.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=

# Printed by `pnpm store:token`. Long-lived, unless the OAuth consent screen is
# still in "Testing" — then it expires after 7 days.
CWS_REFRESH_TOKEN=
